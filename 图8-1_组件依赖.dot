digraph ClientD {
  graph [rankdir=LR, fontname="Noto Sans CJK SC", label="图8-1 安卓客户端组件依赖（D 原型）", labelloc=t];
  node [shape=box, style="rounded,filled", fillcolor="#eaf2f8", fontname="Noto Sans CJK SC"];
  edge [fontname="Noto Sans CJK SC"];
  UI [label="MainActivity\n已编码 / 待编译"];
  Capture [label="PcmRecorder\n已编码 / 待真机验证"];
  Interface [label="RecognitionAdapter\n公共接口", fillcolor="#d5f5e3"];
  Demo [label="DemoAdapter\n模拟"];
  Remote [label="RemoteAdapter\n待 B 联调"];
  Local [label="LocalSherpaAdapter\n计划", fillcolor="#fdebd0"];
  Session [label="AnswerSession\n已通过规则检查"];
  Match [label="KeywordMatcher\n已通过规则检查"];
  Store [label="RecordStore\n待真机验证"];
  Analysis [label="AnalysisPort\n计划", fillcolor="#fdebd0"];
  UI -> Capture [label="启停"];
  Capture -> Interface [label="PCM16 / 样本位置"];
  UI -> Interface [label="配置 / 结果"];
  Interface -> Demo;
  Interface -> Remote;
  Interface -> Local;
  UI -> Session;
  Session -> Match [label="累计最终文本"];
  UI -> Store [label="保存 / 读取 / 删除"];
  UI -> Analysis [style=dashed];
}
