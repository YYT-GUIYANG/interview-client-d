digraph ClientD {
  graph [rankdir=LR, fontname="Noto Sans CJK SC", label="图8-1 安卓客户端组件依赖（D）", labelloc=t];
  node [shape=box, style="rounded,filled", fillcolor="#eaf2f8", fontname="Noto Sans CJK SC"];
  edge [fontname="Noto Sans CJK SC"];
  UI [label="MainActivity\n已编码 / 旧版 CI 已编译"];
  Capture [label="PcmRecorder\n已编码 / 待真机验证"];
  Interface [label="RecognitionAdapter\n公共接口", fillcolor="#d5f5e3"];
  Demo [label="DemoAdapter\n模拟"];
  Remote [label="RemoteAdapter\n协议样例已测 / 待手机联调"];
  Local [label="LocalSherpaAdapter\n已编码 / 待真机验证"];
  Session [label="AnswerSession\n已通过规则检查"];
  Match [label="KeywordMatcher\n已通过规则检查"];
  Store [label="RecordStore\n加密与账号过滤 / 待真机验证"];
  Identity [label="IdentityGateway\n本机测试身份 / 正式认证待 C"];
  Analysis [label="AnalysisPort\n扩展边界已编码"];
