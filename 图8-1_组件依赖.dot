  UI -> Interface [label="配置 / 结果"];
  Interface -> Demo;
  Interface -> Remote;
  Interface -> Local;
  UI -> Session;
  Session -> Match [label="累计最终文本"];
  UI -> Store [label="保存 / 读取 / 删除"];
  Store -> Identity [label="canAccess"];
  Remote -> B [label="answer_id / float32 / Done"];
